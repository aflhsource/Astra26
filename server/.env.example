NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/trust_pass
CORS_ORIGINS=http://localhost:5173
BODY_LIMIT=1mb
MAX_CLOCK_SKEW_MS=60000
MAX_MESSAGE_TTL_MS=600000
TRUST_PASS_TTL_MS=300000
GATEWAY_KEY_ID=trust-pass-gateway-key-1
GATEWAY_PRIVATE_KEY_PATH=.demo-keys/gateway-private.pem
GATEWAY_PUBLIC_KEY_PATH=.demo-keys/gateway-public.pem
AI_PROVIDER=local
AI_MODEL_VERSION=TP-LOCAL-RISK-1.0
